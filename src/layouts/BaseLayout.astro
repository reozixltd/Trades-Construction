---
/** Page shell: head, theme, ribbon, emergency banner, header, main, footer, mobile call bar. */
import '@/styles/global.css';
import { business } from '@/config/business';
import { SETTINGS_KEY } from '@/lib/settings';
import Seo from '@/components/layout/Seo.astro';
import DemoRibbon from '@/components/layout/DemoRibbon.astro';
import EmergencyBanner from '@/components/layout/EmergencyBanner.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import MobileCallBar from '@/components/layout/MobileCallBar.astro';
import besley from '@fontsource-variable/besley/files/besley-latin-wght-normal.woff2?url';
import jakarta from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import inter from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import barlow600 from '@fontsource/barlow-condensed/files/barlow-condensed-latin-600-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  schema?: Record<string, unknown>;
  noindex?: boolean;
  /** Console and other app-like pages hide the marketing chrome. */
  bare?: boolean;
  /** The page opens on a dark, full-bleed hero: the header sits over it, transparent until scrolled. */
  overlayHeader?: boolean;
}

const { title, description, schema, noindex, bare = false, overlayHeader = false } = Astro.props;

/* Preload only the active theme's fonts (declared in styles/fonts.css). */
const preload: Record<typeof business.theme, string[]> = {
  craft: [besley, jakarta],
  precision: [barlow600, inter],
};
const themeColor: Record<typeof business.theme, string> = { craft: '#26221d', precision: '#1a1f24' };
---

<!doctype html>
<html lang="en-AU" data-theme={business.theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={themeColor[business.theme]} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {preload[business.theme].map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
    <!-- Scroll reveals hide content only when the script that reveals it can run; undone if it never arrives. -->
    <script is:inline>
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('has-motion');
        setTimeout(function () {
          if (!window.__motion) document.documentElement.classList.remove('has-motion');
        }, 3000);
      }
    </script>
    <!-- Applies the owner's emergency setting before first paint (no banner flash). -->
    <script is:inline define:vars={{ settingsKey: SETTINGS_KEY }}>
      try {
        var s = JSON.parse(localStorage.getItem(settingsKey) || '{}');
        if (s.emergencyEnabled === false) document.documentElement.classList.add('emergency-off');
      } catch (e) {}
    </script>
    <Seo title={title} description={description} schema={schema} noindex={noindex || bare} />
  </head>
  <body class:list={{ 'is-bare': bare }}>
    <a class="skip-link" href="#main">Skip to content</a>
    {!bare && <DemoRibbon />}
    {!bare && <EmergencyBanner />}
    {!bare && <Header overlay={overlayHeader} />}
    <main id="main"><slot /></main>
    {!bare && <Footer />}
    {!bare && <MobileCallBar />}
    <script>
      import '@/scripts/site';
      import '@/scripts/motion';
    </script>
  </body>
</html>
