---
import { jsonLd } from '@/lib/schema';
/** Accessible FAQ using native <details>. Pass items, or omit to use the site-wide FAQ collection. */
import { getCollection } from 'astro:content';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  items?: { q: string; a: string }[];
  title?: string;
  surface?: boolean;
}
const { items, title = 'Common questions', surface = false } = Astro.props;
const faqs = items ?? (await getCollection('faqs')).map((f) => f.data);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<section class:list={['section', { 'section--surface': surface }]} aria-labelledby="faq-title">
  <div class="container faq">
    <SectionHeading eyebrow="FAQ" title={title} id="faq-title" />
    <div class="faq__list indent" data-reveal>
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={jsonLd(schema)} />
</section>

<style>
  .faq { display: grid; grid-template-columns: minmax(0, 1fr); }
  .faq__list { border-top: 1px solid var(--color-line-strong); }
  details { border-bottom: 1px solid var(--color-line-strong); }
  summary {
    display: flex; justify-content: space-between; align-items: center; gap: var(--space-md);
    min-height: 4rem; padding-block: var(--space-md);
    font-family: var(--font-display); font-size: var(--text-title); font-weight: var(--display-weight); text-transform: var(--display-case); line-height: 1.3;
    cursor: pointer; list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  /* Plus that turns to a minus: the upright stroke lies down when the answer opens. */
  summary::after {
    content: ''; flex-shrink: 0; width: 0.875rem; height: 0.875rem;
    background:
      linear-gradient(currentColor, currentColor) center / 100% 1.5px no-repeat,
      linear-gradient(currentColor, currentColor) center / 1.5px var(--bar, 100%) no-repeat;
    transition: transform 320ms var(--ease-out);
  }
  details[open] summary::after { --bar: 0%; transform: rotate(180deg); }
  @media (hover: hover) { summary:hover { color: var(--color-accent-text); } }
  details p { padding-bottom: var(--space-lg); max-width: 62ch; color: var(--color-text-muted); line-height: 1.65; }

  /* Open and close smoothly where the browser can animate to height: auto. */
  @supports (interpolate-size: allow-keywords) {
    @media (prefers-reduced-motion: no-preference) {
      details { interpolate-size: allow-keywords; }
      details::details-content { height: 0; overflow: clip; transition: height 360ms var(--ease-out), content-visibility 360ms allow-discrete; }
      details[open]::details-content { height: auto; }
    }
  }
</style>
