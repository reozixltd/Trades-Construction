---
/** Photo picker for the quote form: camera/gallery input, thumbnails, error and reminder. */
import { PHOTO_LIMITS } from '@/lib/leads/validation';
import Icon from '../../ui/Icon.astro';
---

<div class="photo field--full">
  <span class="photo__label" id="q-photos-label">Photos of the job (up to {PHOTO_LIMITS.maxCount})</span>
  <label class="drop" for="q-photos">
    <Icon name="camera" size={22} />
    <span><strong>Take or choose photos</strong><br /><span class="muted">JPG, PNG, HEIC · max 10 MB each</span></span>
  </label>
  <input id="q-photos" class="visually-hidden" name="photos" type="file" accept="image/*,.heic,.heif" multiple aria-labelledby="q-photos-label" aria-describedby="q-photos-err q-photos-hint" />
  <ul role="list" class="thumbs" data-thumbs></ul>
  <p class="photo__error" id="q-photos-err" data-error-for="photos"></p>
  <p class="photo__hint" id="q-photos-hint">Please send real, unedited photos of your own property.</p>
</div>

<style>
  .photo { display: grid; gap: var(--space-2xs); min-width: 0; }
  .photo__label { font-size: var(--text-label); font-weight: 600; color: var(--color-text-muted); }
  .drop {
    display: flex; align-items: center; gap: var(--space-sm);
    min-height: var(--control-height); padding: var(--space-md);
    border: 1.5px dashed var(--color-line-strong); border-radius: var(--radius-md);
    background: var(--color-canvas); cursor: pointer; font-size: var(--text-body-sm);
  }
  .drop:hover { border-color: var(--color-ink); }
  .drop:has(+ input:focus-visible) { box-shadow: var(--focus-ring); }
  .thumbs { display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  .thumbs:empty { display: none; }
  .thumbs :global(li) { position: relative; width: 4.5rem; height: 4.5rem; border-radius: var(--radius-sm); overflow: hidden; background: var(--color-inset); border: 1px solid var(--color-line); }
  .thumbs :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .thumbs :global(.thumbs__name) { display: grid; place-items: center; height: 100%; padding: 4px; font-size: 10px; text-align: center; word-break: break-all; }
  .thumbs :global(button) {
    position: absolute; top: 0; right: 0; display: grid; place-items: center;
    width: 1.75rem; height: 1.75rem; border: 0; border-radius: 0 0 0 var(--radius-sm);
    background: var(--color-ink); color: var(--color-on-dark); font-size: 16px; line-height: 1;
  }
  .photo__error { color: var(--color-danger); font-size: var(--text-body-sm); }
  .photo__error:empty { display: none; }
  .photo__hint { color: var(--color-text-subtle); font-size: var(--text-body-sm); }
</style>
