---
import { getCollection } from 'astro:content';
import { business } from '@/config/business';
import { telHref } from '@/lib/format';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import Photo from '../ui/Photo.astro';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const latest = (await getCollection('projects')).find((p) => p.data.featured);
---

<section class="hero">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="hero__kicker"><span class="hero__dot" aria-hidden="true"></span>{business.kicker}</p>
      <h1>
        {business.headline.trade} in <span class="hero__area">{business.headline.area}</span>
      </h1>
      <p class="hero__intro">{business.intro}</p>

      <div class="hero__ctas">
        <Button href="/quote/" variant="accent" size="lg" iconEnd="arrowRight">Get a quote</Button>
        <Button href={telHref(business.contact.phone)} variant="outline" size="lg" icon="phone">{business.contact.phone}</Button>
      </div>
      <p class="hero__promise"><Icon name="clock" size={16} /><span data-live="callback">{business.defaults.callbackPromise}</span></p>

      <nav class="hero__services" aria-label="Services">
        {services.map((s, i) => (
          <a href={`/services/${s.id}/`}><span class="hero__num">0{i + 1}</span>{s.data.title}</a>
        ))}
      </nav>
    </div>

    <div class="hero__media">
      <Photo slot="hero" ratio="4 / 5" priority sizes="(min-width: 960px) 36vw, 100vw" tone="timber" class="hero__photo" />
      {latest && (
        <a class="hero__card" href="/projects/">
          <p class="hero__card-label">{business.demoMode ? 'Sample project' : 'Latest handover'}</p>
          <p class="hero__card-title">{latest.data.title}</p>
          <p class="hero__card-meta">{latest.data.suburb} · {latest.data.duration} · {latest.data.specs[0]?.value}</p>
        </a>
      )}
    </div>
  </div>
</section>

<style>
  /* Faint blueprint grid behind the hero, fading out toward the bottom. */
  .hero {
    position: relative;
    padding-block: var(--space-xl) var(--space-2xl);
    background-image:
      linear-gradient(to bottom, transparent, var(--color-canvas) 85%),
      linear-gradient(var(--color-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-line) 1px, transparent 1px);
    background-size: auto, 48px 48px, 48px 48px;
  }
  .hero__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-xl); align-items: center; }
  .hero__kicker {
    display: inline-flex; align-items: center; gap: var(--space-xs);
    padding: 0.3rem 0.7rem; margin-bottom: var(--space-md);
    background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-sm);
    font-size: var(--text-label); font-weight: 700; letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--color-text-muted);
  }
  .hero__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--color-success); box-shadow: 0 0 0 3px var(--color-success-soft); }
  .hero h1 { max-width: 16ch; }
  .hero__area { color: var(--color-accent-text); }
  .hero__intro { margin-top: var(--space-md); max-width: 36rem; color: var(--color-text-muted); font-size: var(--text-body-lg); line-height: 1.55; }
  .hero__ctas { display: grid; gap: var(--space-sm); margin-top: var(--space-lg); }
  @media (min-width: 480px) { .hero__ctas { display: flex; flex-wrap: wrap; } }
  .hero__promise { display: flex; align-items: center; gap: var(--space-xs); margin-top: var(--space-sm); color: var(--color-text-muted); font-size: var(--text-body-sm); font-weight: 600; }
  .hero__promise :global(.icon) { color: var(--color-success); }
  .hero__services { display: flex; flex-wrap: wrap; gap: var(--space-xs); margin-top: var(--space-xl); }
  .hero__services a {
    display: inline-flex; align-items: center; gap: var(--space-xs);
    min-height: var(--control-height); padding: 0 var(--space-sm);
    background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-sm);
    font-size: var(--text-body-sm); font-weight: 600; text-decoration: none;
  }
  .hero__services a:hover { border-color: var(--color-ink); color: var(--color-ink); }
  .hero__num { color: var(--color-accent-text); font-size: var(--text-label-sm); font-weight: 700; font-variant-numeric: tabular-nums; }

  .hero__media { position: relative; }
  .hero__media :global(.hero__photo) { aspect-ratio: 16 / 10 !important; }
  a.hero__card { text-decoration: none; color: var(--color-ink); }
  .hero__card {
    display: none;
    position: absolute; left: calc(-1 * var(--space-xl)); bottom: var(--space-xl);
    padding: var(--space-md) var(--space-lg); max-width: 17rem;
    background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-md); box-shadow: var(--shadow-2);
  }
  .hero__card-label { color: var(--color-accent-text); font-size: var(--text-label-sm); font-weight: 700; letter-spacing: var(--tracking-label-sm); text-transform: uppercase; }
  .hero__card-title { margin-top: 2px; font-family: var(--font-display); font-weight: 700; font-size: var(--text-title); }
  .hero__card-meta { color: var(--color-text-muted); font-size: var(--text-body-sm); }

  @media (min-width: 960px) {
    .hero { padding-block: var(--space-2xl) var(--space-3xl); }
    .hero__grid { grid-template-columns: 1.25fr 0.75fr; gap: var(--space-2xl); }
    .hero__media :global(.hero__photo) { aspect-ratio: 4 / 5 !important; }
    .hero__card { display: block; }
  }
</style>
