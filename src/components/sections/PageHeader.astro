---
import { jsonLd } from '@/lib/schema';
/** Inner-page header: breadcrumb, title, lead, optional actions slot. */
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  title: string;
  lead?: string;
  eyebrow?: string;
  crumbs?: Crumb[];
}
const { title, lead, eyebrow, crumbs = [] } = Astro.props;
const all: Crumb[] = [{ label: 'Home', href: '/' }, ...crumbs];
const crumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: all.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.label, item: c.href ? new URL(c.href, Astro.site).href : undefined })),
};
---

<header class="ph-head">
  <div class="container">
    <nav aria-label="Breadcrumb">
      <ol role="list" class="crumbs">
        {all.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>)}
      </ol>
    </nav>
    {eyebrow && <p class="ph-head__eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="ph-head__lead">{lead}</p>}
    {Astro.slots.has('default') && <div class="ph-head__actions"><slot /></div>}
  </div>
  <script type="application/ld+json" set:html={jsonLd(crumbSchema)} />
</header>

<style>
  .ph-head { padding-block: var(--space-xl) var(--space-2xl); background: var(--color-surface); border-bottom: 1px solid var(--color-line); }
  .crumbs { display: flex; flex-wrap: wrap; gap: var(--space-2xs); margin-bottom: var(--space-lg); padding-bottom: var(--space-sm); border-bottom: 1px solid var(--color-line-strong); font-size: var(--text-body-sm); color: var(--color-text-subtle); }
  .crumbs li + li::before { content: '/'; margin-right: var(--space-2xs); color: var(--color-line-strong); }
  .crumbs a { color: var(--color-text-muted); }
  .ph-head__eyebrow { display: flex; align-items: baseline; gap: var(--space-xs); margin-bottom: var(--space-sm); color: var(--color-text-muted); font-size: var(--text-label); font-weight: 600; letter-spacing: var(--tracking-label); text-transform: var(--label-case); }
  .ph-head__eyebrow::before { content: ''; flex-shrink: 0; width: 7px; height: 7px; background: var(--color-accent); transform: translateY(-1px); }
  .ph-head h1 { max-width: 20ch; font-size: clamp(2.25rem, 1.3rem + 3.6vw, 4rem); }
  .ph-head__lead { margin-top: var(--space-md); max-width: 40rem; color: var(--color-text-muted); font-size: var(--text-body-lg); line-height: 1.55; }
  .ph-head__actions { display: flex; flex-wrap: wrap; gap: var(--space-sm); margin-top: var(--space-xl); }
  @media (min-width: 768px) { .ph-head { padding-block: var(--space-2xl) var(--space-3xl); } }
  /* Same quiet entrance as the home hero, CSS only. */
  @media (prefers-reduced-motion: no-preference) {
    .ph-head h1, .ph-head__lead, .ph-head__actions { animation: ph-rise 800ms var(--ease-out) both; }
    .ph-head__lead { animation-delay: 90ms; }
    .ph-head__actions { animation-delay: 180ms; }
  }
  @keyframes ph-rise { from { opacity: 0; transform: translateY(1rem); } }
</style>
