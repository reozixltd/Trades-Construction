---
/**
 * Two-step quote request.
 *   Step 1 (required): name, phone, job — always enough to submit.
 *   Step 2 (optional): photos, service, suburb, urgency, best time, property type, email.
 * Behaviour: scripts/quote-form.ts · Validation: lib/leads/validation.ts
 */
import { getCollection } from 'astro:content';
import { business } from '@/config/business';
import { telHref } from '@/lib/format';
import { JOB_LENGTH } from '@/lib/leads/validation';
import { URGENCY_LABELS, URGENCIES } from '@/lib/leads/types';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import PhotoField from './quote/PhotoField.astro';
import QuoteDone from './quote/QuoteDone.astro';

interface Props {
  /** Open the optional details by default (the full /quote page). */
  expanded?: boolean;
  source?: string;
}
const { expanded = false, source = 'website' } = Astro.props;
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const areaData = JSON.stringify({ covered: business.areas.covered, nearby: business.areas.nearby });
---

<div class="quote" data-quote-form data-areas={areaData} data-phone={business.contact.phone} data-tel={telHref(business.contact.phone)}>
  <form class="quote__form" novalidate data-source={source}>
    <div class="summary" role="alert" tabindex="-1" hidden data-error-summary aria-labelledby="q-summary-title">
      <p class="summary__title" id="q-summary-title">Please fix these to send your request:</p>
      <ul data-error-list></ul>
    </div>
    <fieldset class="quote__step">
      <legend class="quote__legend"><span class="quote__num">1</span> Your details <span class="quote__tag">Required</span></legend>
      <div class="field">
        <label for="q-name">Your name</label>
        <input id="q-name" name="name" type="text" autocomplete="name" required minlength="2" aria-describedby="q-name-err" />
        <p class="field__error" id="q-name-err" data-error-for="name"></p>
      </div>
      <div class="field">
        <label for="q-phone">Mobile or phone</label>
        <input id="q-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required placeholder="04xx xxx xxx" aria-describedby="q-phone-err" />
        <p class="field__error" id="q-phone-err" data-error-for="phone"></p>
      </div>
      <div class="field field--full">
        <label for="q-job">What do you need done?</label>
        <textarea id="q-job" name="job" rows="4" required minlength={JOB_LENGTH.min} maxlength={JOB_LENGTH.max} placeholder="e.g. Shower is leaking through the wall into the hallway" aria-describedby="q-job-err"></textarea>
        <p class="field__error" id="q-job-err" data-error-for="job"></p>
      </div>
    </fieldset>

    <details class="quote__more" open={expanded}>
      <summary>
        <span class="quote__legend"><span class="quote__num">2</span> Add photos & details <span class="quote__tag">Optional, helps us quote faster</span></span>
      </summary>
      <div class="quote__step quote__step--two">
        <PhotoField />
        <div class="field">
          <label for="q-service">Type of work</label>
          <select id="q-service" name="service">
            <option value="">Not sure yet</option>
            {services.map((s) => <option value={s.id}>{s.data.title}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="q-suburb">Suburb or postcode</label>
          <input id="q-suburb" name="suburb" type="text" autocomplete="address-level2" aria-describedby="q-suburb-note" />
          <p class="field__hint" id="q-suburb-note" data-suburb-note aria-live="polite"></p>
        </div>
        <fieldset class="field field--full chips">
          <legend>How soon?</legend>
          {URGENCIES.map((u) => (
            <label class:list={['chip', { 'chip--danger': u === 'emergency' }]}>
              <input type="radio" name="urgency" value={u} data-live={u === 'emergency' ? 'emergency-option' : undefined} />
              <span>{URGENCY_LABELS[u]}</span>
            </label>
          ))}
        </fieldset>
        <div class="field">
          <label for="q-time">Best time to call</label>
          <select id="q-time" name="bestTime">
            <option value="">Any time</option>
            <option>Morning</option>
            <option>Lunchtime</option>
            <option>Afternoon</option>
            <option>After 5pm</option>
          </select>
        </div>
        <div class="field">
          <label for="q-property">Property type</label>
          <select id="q-property" name="propertyType">
            <option value="">Select</option>
            <option value="house">House</option>
            <option value="townhouse">Townhouse</option>
            <option value="unit">Unit / apartment</option>
            <option value="commercial">Commercial</option>
          </select>
        </div>
        <div class="field field--full">
          <label for="q-email">Email <span class="muted">(for a copy of your request)</span></label>
          <input id="q-email" name="email" type="email" autocomplete="email" aria-describedby="q-email-err" />
          <p class="field__error" id="q-email-err" data-error-for="email"></p>
        </div>
      </div>
    </details>

    <!-- Honeypot: hidden from people, tempting to bots. -->
    <div class="hp" aria-hidden="true">
      <label for="q-website">Website</label>
      <input id="q-website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <div class="quote__submit">
      <p class="quote__consent">By sending this you agree to our <a href="/privacy/">privacy policy</a>. We only use your details to respond to this request.</p>
      <Button type="submit" variant="accent" size="lg" block iconEnd="arrowRight">Send my request</Button>
      <p class="quote__promise"><Icon name="clock" size={16} /><span data-live="callback">{business.defaults.callbackPromise}</span></p>
      <p class="quote__status" role="alert" data-form-status></p>
    </div>
  </form>

  <QuoteDone />
</div>

<script>import '@/scripts/quote-form';</script>

<style>
  .quote { background: var(--color-surface); border-top: 2px solid var(--color-ink); border-radius: 0 0 var(--radius-md) var(--radius-md); box-shadow: var(--shadow-2); }
  .quote__form { padding: var(--space-lg); }
  .summary { margin-bottom: var(--space-lg); padding: var(--space-md); border: 1px solid var(--color-danger-line); border-left: 4px solid var(--color-danger); border-radius: var(--radius-sm); background: var(--color-danger-soft); }
  .summary:focus { outline: none; box-shadow: var(--focus-ring); }
  .summary__title { font-weight: 700; color: var(--color-danger); }
  .summary :global(ul) { margin: var(--space-2xs) 0 0; padding-left: 1.1rem; }
  .summary :global(a) { color: var(--color-danger); font-weight: 600; }
  .quote__form :global(button[aria-busy='true']) { cursor: progress; opacity: 0.8; }
  .quote__step { display: grid; gap: var(--space-md); margin: 0; padding: 0; border: 0; }
  .quote__step--two { padding-top: var(--space-md); }
  .quote__legend { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-xs); padding: 0; margin-bottom: var(--space-xs); font-family: var(--font-display); font-size: var(--text-headline-sm); font-weight: var(--display-weight); text-transform: var(--display-case); }
  .quote__num { display: inline-grid; place-items: center; width: 1.6rem; height: 1.6rem; border-radius: var(--radius-sm); background: var(--color-ink); color: var(--color-on-dark); font-family: var(--font-body); font-size: var(--text-label); }
  .quote__tag { font-family: var(--font-body); font-size: var(--text-label-sm); font-weight: 500; letter-spacing: var(--tracking-label-sm); text-transform: none; color: var(--color-text-subtle); }
  .quote__more { margin-top: var(--space-lg); padding-top: var(--space-md); border-top: 1px solid var(--color-line); }
  .quote__more summary { display: flex; align-items: center; justify-content: space-between; min-height: var(--control-height); cursor: pointer; list-style: none; }
  .quote__more summary::-webkit-details-marker { display: none; }
  .quote__more summary::after {
    content: ''; flex-shrink: 0; width: 0.875rem; height: 0.875rem;
    background:
      linear-gradient(currentColor, currentColor) center / 100% 1.5px no-repeat,
      linear-gradient(currentColor, currentColor) center / 1.5px var(--bar, 100%) no-repeat;
  }
  .quote__more[open] summary::after { --bar: 0%; }
  .quote__more summary .quote__legend { margin: 0; }

  .field { display: grid; gap: var(--space-2xs); min-width: 0; }
  .field label, .field legend { font-size: var(--text-label); font-weight: 600; color: var(--color-text); }
  .field input, .field select, .field textarea {
    width: 100%; min-height: 3rem; padding: var(--space-xs) var(--space-sm);
    background: var(--color-surface); border: 1px solid var(--color-field-line); border-radius: var(--radius-sm);
    font-size: 1rem; /* 16px stops iOS zoom */
  }
  .field textarea { resize: vertical; line-height: 1.5; }
  .field input:focus, .field select:focus, .field textarea:focus { outline: none; border-color: var(--color-ink); box-shadow: 0 0 0 1px var(--color-ink); }
  .field [aria-invalid='true'] { border-color: var(--color-danger); box-shadow: 0 0 0 1px var(--color-danger); }
  .field__error { color: var(--color-danger); font-size: var(--text-body-sm); }
  .field__error:empty { display: none; }
  .field__hint { color: var(--color-text-subtle); font-size: var(--text-body-sm); }
  .field__hint:empty { display: none; }

  .chips { display: flex; flex-wrap: wrap; gap: var(--space-xs); margin: 0; padding: 0; border: 0; }
  .chips legend { margin-bottom: var(--space-2xs); }
  .chip { position: relative; }
  .chip input { position: absolute; opacity: 0; inset: 0; }
  .chip span { display: inline-flex; align-items: center; min-height: var(--control-height); padding: 0 var(--space-md); border: 1px solid var(--color-field-line); border-radius: var(--radius-full); font-size: var(--text-body-sm); font-weight: 600; cursor: pointer; transition: background-color var(--duration), border-color var(--duration), color var(--duration); }
  .chip input:checked + span { background: var(--color-ink); border-color: var(--color-ink); color: var(--color-on-dark); }
  .chip--danger input:checked + span { background: var(--color-danger); border-color: var(--color-danger); }
  .chip input:focus-visible + span { box-shadow: var(--focus-ring); }
  @media (hover: hover) { .chip span:hover { border-color: var(--color-ink); } }

  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .quote__submit { display: grid; gap: var(--space-sm); margin-top: var(--space-lg); padding-top: var(--space-lg); border-top: 1px solid var(--color-line); }
  .quote__consent { color: var(--color-text-subtle); font-size: var(--text-body-sm); }
  .quote__promise { display: flex; justify-content: center; align-items: center; gap: var(--space-xs); color: var(--color-text-muted); font-size: var(--text-body-sm); font-weight: 600; }
  .quote__promise :global(.icon) { color: var(--color-success); }
  .quote__status { color: var(--color-danger); font-size: var(--text-body-sm); font-weight: 600; text-align: center; }
  .quote__status:empty { display: none; }

  @media (min-width: 640px) {
    .quote__step { grid-template-columns: 1fr 1fr; }
    .quote__step legend.quote__legend { grid-column: 1 / -1; }
    .field--full, .quote__step :global(.field--full) { grid-column: 1 / -1; }
    .quote__form { padding: var(--space-xl); }
  }
</style>
