---
/**
 * "How we price" — plain-language replacement for the Stitch mock's GMP / cost-plus tiers.
 * Shows full "from" prices incl. GST (NSW: no partial pricing).
 */
import { getCollection } from 'astro:content';
import { formatAud } from '@/lib/format';
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import { pricingIntro, pricingModels } from '@/config/pricing';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const priceFor = (m: (typeof pricingModels)[number]) => {
  if ('text' in m.price) return m.price.text;
  const id = m.price.fromService;
  const s = services.find((x) => x.id === id);
  return s ? `${formatAud(s.data.priceFrom)} ${s.data.priceUnit}`.trim() : '';
};
const models = pricingModels.map((m) => ({ ...m, priceText: priceFor(m) }));

---

<section class="section section--surface" aria-labelledby="pricing-title">
  <div class="container">
    <SectionHeading
      eyebrow="How we price"
      title={pricingIntro.title}
      lead={pricingIntro.lead}
      id="pricing-title"
    />

    <div class="models">
      {models.map((m, i) => (
        <article class:list={['model', { 'model--featured': m.featured }]} data-reveal style={`--i: ${i}`}>
          {m.featured && <p class="model__flag">Most jobs</p>}
          <h3 class="model__name">{m.name}</h3>
          <p class="model__price">{m.priceText}</p>
          <p class="model__note">{m.note}</p>
          <ul role="list" class="model__points">
            {m.points.map((pt) => <li><Icon name="check" size={16} />{pt}</li>)}
          </ul>
          <Button href={m.cta.href} variant={m.featured ? 'accent' : 'outline'} block>{m.cta.label}</Button>
        </article>
      ))}
    </div>

    <div class="table-wrap" data-reveal>
      <table class="prices">
        <caption>Starting prices by service (incl. GST)</caption>
        <thead><tr><th scope="col">Service</th><th scope="col">From</th><th scope="col">What that covers</th></tr></thead>
        <tbody>
          {services.map((s) => (
            <tr>
              <th scope="row"><a href={`/services/${s.id}/`}>{s.data.title}</a></th>
              <td class="num">{formatAud(s.data.priceFrom)}{s.data.priceUnit && ` ${s.data.priceUnit}`}</td>
              <td>{s.data.priceNote}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  /* Three ways of pricing as columns under one rule; the usual one carries the accent line. */
  .models { display: grid; gap: var(--space-xl) 0; }
  .model { position: relative; display: flex; flex-direction: column; padding-top: var(--space-lg); border-top: 1px solid var(--color-line-strong); }
  .model--featured { border-top-color: var(--color-accent); box-shadow: inset 0 2px 0 var(--color-accent); }
  .model__flag { position: absolute; top: var(--space-lg); right: 0; padding: 0.15rem 0.6rem; background: var(--color-accent); color: var(--color-on-accent); border-radius: var(--radius-sm); font-size: var(--text-label-sm); font-weight: 600; }
  .model__name { font-family: var(--font-body); font-size: var(--text-label); font-weight: 600; letter-spacing: var(--tracking-label); text-transform: var(--label-case); color: var(--color-text-muted); }
  .model__price { margin-top: var(--space-xs); font-family: var(--font-display); font-size: var(--text-headline-lg); font-weight: var(--display-weight); text-transform: var(--display-case); line-height: 1.12; letter-spacing: var(--tracking-display); }
  .model__note { margin-top: var(--space-sm); color: var(--color-text-muted); line-height: 1.55; }
  .model__points { margin-block: var(--space-lg); flex: 1; }
  .model__points li { display: flex; gap: var(--space-xs); padding-block: var(--space-xs); border-top: 1px solid var(--color-line); font-size: var(--text-body-sm); }
  .model__points :global(.icon) { margin-top: 3px; color: var(--color-accent-text); }

  .table-wrap { margin-top: var(--space-2xl); overflow-x: auto; }
  .prices { width: 100%; border-collapse: collapse; font-size: var(--text-body-sm); }
  .prices caption { padding-bottom: var(--space-sm); text-align: left; font-family: var(--font-display); font-size: var(--text-title); font-weight: var(--display-weight); text-transform: var(--display-case); }
  .prices th, .prices td { padding: var(--space-sm) var(--space-md) var(--space-sm) 0; text-align: left; vertical-align: top; border-bottom: 1px solid var(--color-line); }
  .prices thead th { border-bottom-color: var(--color-line-strong); border-top: 1px solid var(--color-line-strong); color: var(--color-text-muted); font-size: var(--text-label-sm); font-weight: 500; }
  .prices tbody th { font-weight: 600; }
  .prices .num { font-weight: 700; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .prices td:last-child { min-width: 16rem; color: var(--color-text-muted); }

  /* On a phone the table reads as a list: service and price on one line, what it covers underneath. */
  @media (max-width: 639px) {
    .prices thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .prices tr { display: grid; grid-template-columns: 1fr auto; gap: 0 var(--space-md); padding-block: var(--space-sm); border-bottom: 1px solid var(--color-line); }
    .prices tbody tr:first-child { border-top: 1px solid var(--color-line-strong); }
    .prices th, .prices td { padding: 0; border: 0; }
    .prices td:last-child { grid-column: 1 / -1; min-width: 0; margin-top: var(--space-2xs); }
  }
  @media (min-width: 900px) {
    .models { grid-template-columns: repeat(3, 1fr); gap: 0 calc(var(--gutter) * 2); align-items: stretch; }
  }
</style>
