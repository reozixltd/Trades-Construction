---
/** Project gallery with an optional service filter (progressive: all projects show without JS). */
import { getCollection, type CollectionEntry } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

interface Props {
  projects: CollectionEntry<'projects'>[];
  filterable?: boolean;
}
const { projects, filterable = false } = Astro.props;
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const titleFor = (id: string) => services.find((s) => s.id === id)?.data.title ?? id;
const used = services.filter((s) => projects.some((p) => p.data.service === s.id));
---

<div data-project-grid>
  {
    filterable && (
      <div class="filters" role="group" aria-label="Filter projects by service">
        <button type="button" class="filter" aria-pressed="true" data-filter="all">All ({projects.length})</button>
        {used.map((s) => (
          <button type="button" class="filter" aria-pressed="false" data-filter={s.id}>{s.data.title}</button>
        ))}
      </div>
    )
  }
  <div class="projects">
    {projects.map((p, i) => <ProjectCard project={p} serviceTitle={titleFor(p.data.service)} index={i} />)}
  </div>
  <p class="filters__status visually-hidden" aria-live="polite" data-filter-status></p>
</div>

{filterable && <script>import '@/scripts/project-filter';</script>}

<style>
  .projects { display: grid; gap: var(--space-2xl) var(--gutter); }
  @media (min-width: 640px) { .projects { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1000px) { .projects { grid-template-columns: repeat(3, 1fr); gap: var(--space-2xl) calc(var(--gutter) * 1.5); } }

  .filters { display: flex; flex-wrap: wrap; gap: var(--space-xs); margin-bottom: var(--space-xl); }
  .filter {
    min-height: var(--control-height); padding: 0 var(--space-md);
    background: transparent; color: var(--color-text); border: 1px solid var(--color-line-strong); border-radius: var(--radius-full);
    font-size: var(--text-body-sm); font-weight: 600;
    transition: background-color var(--duration), border-color var(--duration), color var(--duration);
  }
  @media (hover: hover) { .filter:hover { border-color: var(--color-ink); } }
  .filter[aria-pressed='true'] { background: var(--color-ink); border-color: var(--color-ink); color: var(--color-on-dark); }
</style>
