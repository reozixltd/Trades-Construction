---
/** A finished job: photo plate, where and when, what was done, and up to three facts. Not a link — there are no project pages. */
import type { CollectionEntry } from 'astro:content';
import Photo from '../ui/Photo.astro';
import Placeholder from '../ui/Placeholder.astro';
import { isPhotoSlot } from '@/lib/photos';
import Badge from '../ui/Badge.astro';
import { business } from '@/config/business';

interface Props {
  project: CollectionEntry<'projects'>;
  serviceTitle: string;
  index?: number;
}
const { project, serviceTitle, index = 0 } = Astro.props;
const p = project.data;
const slot = `project-${project.id}`;
---

<article class="project" data-service={p.service} data-reveal style={`--i: ${index % 3}`}>
  <div class="project__media">
    {isPhotoSlot(slot) ? (
      <Photo slot={slot} ratio="4 / 3" sizes="(min-width: 1000px) 31vw, (min-width: 640px) 48vw, 100vw" tone={p.tone} />
    ) : (
      <Placeholder tone={p.tone} label={`Job photo · ${p.suburb}`} caption={p.title} />
    )}
    {business.demoMode && <span class="project__sample"><Badge tone="warning">Sample</Badge></span>}
  </div>
  <div class="project__body">
    <p class="project__meta">{serviceTitle} · {p.suburb}</p>
    <h3 class="project__title">{p.title}</h3>
    <p class="project__summary">{p.summary}</p>
    <dl class="project__specs">
      <div><dt>Completed</dt><dd>{p.completed}</dd></div>
      <div><dt>Duration</dt><dd>{p.duration}</dd></div>
      {p.specs.map((s) => <div><dt>{s.label}</dt><dd>{s.value}</dd></div>)}
    </dl>
  </div>
</article>

<style>
  .project { display: flex; flex-direction: column; }
  .project__media { position: relative; overflow: hidden; border-radius: var(--radius-md); }
  .project__media :global(.ph), .project__media :global(.photo) { border-radius: 0; }
  .project__media :global(img) { transition: transform 1200ms var(--ease-out); }
  @media (hover: hover) { .project:hover .project__media :global(img) { transform: scale(1.04); } }
  .project__sample { position: absolute; top: var(--space-sm); left: var(--space-sm); display: flex; }

  .project__body { display: flex; flex-direction: column; flex: 1; padding-top: var(--space-md); }
  .project__meta { color: var(--color-text-muted); font-size: var(--text-label); font-weight: 600; }
  .project__title { margin-top: var(--space-2xs); font-size: var(--text-headline-sm); line-height: 1.2; }
  .project__summary { margin-top: var(--space-xs); color: var(--color-text-muted); line-height: 1.6; }
  .project__specs { display: grid; grid-template-columns: 1fr 1fr; gap: 0 var(--gutter); margin: auto 0 0; padding-top: var(--space-md); }
  .project__specs div { display: flex; justify-content: space-between; gap: var(--space-xs); padding-block: var(--space-xs); border-top: 1px solid var(--color-line); font-size: var(--text-body-sm); }
  .project__specs dt { color: var(--color-text-muted); }
  .project__specs dd { margin: 0; font-weight: 600; text-align: right; }
</style>
