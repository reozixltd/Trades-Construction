---
import type { CollectionEntry } from 'astro:content';
import { formatAud } from '@/lib/format';
import Icon from '../ui/Icon.astro';
import Badge from '../ui/Badge.astro';
import Photo from '../ui/Photo.astro';
import { isPhotoSlot } from '@/lib/photos';

interface Props {
  service: CollectionEntry<'services'>;
  index: number;
}
const { service, index } = Astro.props;
const s = service.data;
const slot = `service-${service.id}`;
---

<article class="card">
  {isPhotoSlot(slot) && <Photo slot={slot} ratio="16 / 10" sizes="(min-width: 1200px) 25vw, (min-width: 640px) 50vw, 100vw" class="card__photo" />}
  <header class="card__head">
    <p class="card__eyebrow">0{index + 1} // {s.eyebrow}</p>
    <Icon name={s.icon} size={22} />
  </header>
  <h3 class="card__title"><a href={`/services/${service.id}/`}>{s.title}</a></h3>
  <p class="card__summary">{s.summary}</p>

  <dl class="card__spec">
    <div><dt>From</dt><dd>{formatAud(s.priceFrom)}{s.priceUnit && <span> {s.priceUnit}</span>}</dd></div>
    <div><dt>Typical time</dt><dd>{s.typicalTime}</dd></div>
  </dl>

  <ul role="list" class="card__list">
    {s.includes.slice(0, 3).map((item) => <li><Icon name="checkCircle" size={16} />{item}</li>)}
  </ul>

  <footer class="card__foot">
    {s.emergency && <span data-live="emergency"><Badge tone="danger">24/7 make-safe</Badge></span>}
    <a class="card__link" href={`/services/${service.id}/`}>Details & pricing<Icon name="arrowRight" size={16} /></a>
  </footer>
</article>

<style>
  .card { position: relative; display: flex; flex-direction: column; padding: var(--space-lg); background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-md); box-shadow: var(--shadow-1); transition: border-color var(--duration); }
  .card:hover { border-color: var(--color-line-strong); transform: translateY(-2px); box-shadow: var(--shadow-2); }
  .card { transition: border-color 200ms, transform 200ms, box-shadow 200ms; }
  .card :global(.card__photo) { margin: calc(-1 * var(--space-lg)) calc(-1 * var(--space-lg)) var(--space-md); border-radius: var(--radius-md) var(--radius-md) 0 0; }
  .card__head { display: flex; justify-content: space-between; align-items: center; color: var(--color-text-subtle); }
  .card__eyebrow { color: var(--color-accent-text); font-size: var(--text-label-sm); font-weight: 700; letter-spacing: var(--tracking-label-sm); text-transform: uppercase; }
  .card__title { margin-top: var(--space-md); font-size: var(--text-headline-sm); }
  .card__title a { text-decoration: none; }
  .card__title a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .card__summary { margin-top: var(--space-xs); color: var(--color-text-muted); font-size: var(--text-body-sm); line-height: 1.55; }
  .card__spec { margin: var(--space-md) 0 0; padding: var(--space-sm) 0; border-block: 1px solid var(--color-inset); font-size: var(--text-body-sm); }
  .card__spec div { display: flex; justify-content: space-between; gap: var(--space-sm); padding-block: 2px; }
  .card__spec dt { color: var(--color-text-subtle); font-size: var(--text-label-sm); font-weight: 700; letter-spacing: var(--tracking-label-sm); text-transform: uppercase; }
  .card__spec dd { margin: 0; font-weight: 700; text-align: right; font-variant-numeric: tabular-nums; }
  .card__spec dd span { color: var(--color-text-muted); font-weight: 500; }
  .card__list { margin-top: var(--space-md); font-size: var(--text-body-sm); }
  .card__list li { display: flex; gap: var(--space-xs); align-items: flex-start; }
  .card__list li + li { margin-top: var(--space-xs); }
  .card__list :global(.icon) { margin-top: 3px; color: var(--color-success); }
  .card__foot { display: flex; align-items: center; justify-content: space-between; gap: var(--space-sm); margin-top: auto; padding-top: var(--space-lg); }
  .card__link { position: relative; z-index: 1; display: inline-flex; align-items: center; gap: var(--space-2xs); margin-left: auto; font-size: 0.875rem; font-weight: 700; text-decoration: none; }
</style>
