---
/** Featured case study with a keyboard-operable before/after comparison and quoted-vs-final price. */
import type { CollectionEntry } from 'astro:content';
import { formatAud } from '@/lib/format';
import SectionHeading from '../ui/SectionHeading.astro';
import Photo from '../ui/Photo.astro';
import Icon from '../ui/Icon.astro';
import { isPhotoSlot } from '@/lib/photos';
import Badge from '../ui/Badge.astro';
import { business } from '@/config/business';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const p = project.data;
const cs = p.caseStudy!;
const afterSlot = `project-${project.id}`;
const beforeSlot = `project-${project.id}-before`;
const delta = ((cs.final - cs.quoted) / cs.quoted) * 100;
---

<section class="section section--ink" aria-labelledby="case-title">
  <div class="container">
    <SectionHeading eyebrow="Case study" title={`${p.title}, ${p.suburb}`} id="case-title">
      <div class="case__tags">
        {business.demoMode && <Badge tone="warning">Sample project</Badge>}
        <Badge tone="neutral">{p.duration}</Badge>
        <Badge tone="success">{delta.toFixed(1)}% over quote</Badge>
      </div>
    </SectionHeading>

    <div class="case">
      <div class="case__media" data-reveal>
        <div class="compare" data-compare style="--pos: 50%">
          <div class="compare__layer">{isPhotoSlot(beforeSlot) && <Photo slot={beforeSlot} ratio="4 / 3" chip="Before" tone={cs.beforeTone} sizes="(min-width: 960px) 58vw, 100vw" />}</div>
          <div class="compare__layer compare__layer--after">{isPhotoSlot(afterSlot) && <Photo slot={afterSlot} ratio="4 / 3" chip="After" tone={p.tone} sizes="(min-width: 960px) 58vw, 100vw" />}</div>
          <div class="compare__handle" aria-hidden="true"><span class="compare__grip"><Icon name="swap" size={20} /></span></div>
          <label class="visually-hidden" for="compare-range">Before and after comparison</label>
          <input id="compare-range" class="compare__range" type="range" min="0" max="100" value="50" data-compare-range />
        </div>
        <p class="compare__hint">Drag the divider, or use the arrow keys, to compare.</p>
      </div>

      <div class="case__panel" data-reveal style="--i: 1">
        <p class="case__summary">{p.summary}</p>
        <h3 class="case__subhead">What we solved</h3>
        <ol role="list" class="case__list">
          {cs.challenges.map((c, i) => (
            <li><span class="case__n">{i + 1}</span><div><strong>{c.title}.</strong> {c.text}</div></li>
          ))}
        </ol>
        <dl class="case__money">
          <div><dt>Fixed quote</dt><dd>{formatAud(cs.quoted)}</dd></div>
          <div><dt>Final invoice</dt><dd class="case__final">{formatAud(cs.final)}</dd></div>
        </dl>
        <p class="case__fine">{cs.varianceNote}</p>
      </div>
    </div>
  </div>
</section>

<script>import '@/scripts/before-after';</script>

<style>
  .case__tags { display: flex; gap: var(--space-xs); flex-wrap: wrap; }
  .case { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-xl); }

  .compare { position: relative; overflow: hidden; border-radius: var(--radius-md); background: var(--color-dark-raised); }
  .compare__layer :global(.ph), .compare__layer :global(.photo) { border-radius: 0; }
  .compare__layer--after { position: absolute; inset: 0; clip-path: inset(0 0 0 var(--pos)); }
  .compare__layer--after :global(.ph__label), .compare__layer--after :global(.photo__chip) { left: auto; right: var(--space-sm); }
  .compare__handle { position: absolute; top: 0; bottom: 0; left: var(--pos); width: 2px; margin-left: -1px; background: var(--color-on-dark); pointer-events: none; }
  .compare__grip {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: var(--radius-full);
    background: var(--color-on-dark); color: var(--color-dark); box-shadow: var(--shadow-2);
    transition: transform var(--duration) var(--ease-out);
  }
  .compare__range { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; }
  .compare__range:focus-visible ~ .compare__handle .compare__grip,
  .compare:has(.compare__range:focus-visible) .compare__grip { box-shadow: 0 0 0 3px var(--color-dark), 0 0 0 6px var(--color-accent-on-dark); }
  @media (hover: hover) { .compare:hover .compare__grip { transform: translate(-50%, -50%) scale(1.08); } }
  .compare__hint { margin-top: var(--space-sm); color: var(--color-text-muted); font-size: var(--text-body-sm); }

  .case__summary { font-family: var(--font-display); font-size: var(--text-headline-sm); font-weight: var(--display-weight); line-height: 1.35; }
  /* A full sentence: never set in the display face's capitals. */
  .case__summary { text-transform: none; }
  .case__subhead { margin-top: var(--space-xl); font-family: var(--font-body); font-size: var(--text-label); font-weight: 600; letter-spacing: var(--tracking-label); text-transform: var(--label-case); color: var(--color-text-muted); }
  .case__list { margin-top: var(--space-xs); }
  .case__list li { display: flex; gap: var(--space-md); padding-block: var(--space-md); border-bottom: 1px solid var(--color-line); font-size: var(--text-body); line-height: 1.55; color: var(--color-text-muted); }
  .case__list strong { color: var(--color-text); }
  .case__n { flex-shrink: 0; width: 1.25rem; color: var(--color-accent-text); font-family: var(--font-display); font-size: var(--text-title); font-weight: var(--display-weight); line-height: 1.4; }
  .case__money { display: grid; grid-template-columns: 1fr 1fr; gap: var(--gutter); margin: var(--space-lg) 0 0; }
  .case__money dt { color: var(--color-text-muted); font-size: var(--text-label-sm); font-weight: 500; }
  .case__money dd { margin: 0; font-family: var(--font-display); font-size: var(--text-headline-lg); font-weight: var(--display-weight); line-height: 1.15; font-variant-numeric: tabular-nums; }
  .case__final { color: var(--color-accent-text); }
  .case__fine { margin-top: var(--space-sm); color: var(--color-text-muted); font-size: var(--text-body-sm); }

  @media (min-width: 960px) {
    .case { grid-template-columns: 1.45fr 1fr; gap: calc(var(--gutter) * 2.5); align-items: start; }
  }
</style>
