---
/** Form & Trade mark from the Stitch export, recoloured through tokens so it follows the theme. */
import { business } from '@/config/business';
interface Props {
  inverse?: boolean;
}
const { inverse = false } = Astro.props;
---

<a href="/" class:list={['logo', { 'logo--inverse': inverse }]} aria-label={`${business.tradingName} — home`}>
  <svg viewBox="0 0 48 48" width="40" height="40" aria-hidden="true">
    <rect x="4" y="4" width="40" height="40" rx="3" class="logo__tile" />
    <path d="M12 12H36V18H18V32H12V12Z" class="logo__accent" />
    <rect x="22" y="20" width="14" height="14" rx="1" class="logo__window" />
    <circle cx="29" cy="27" r="3" class="logo__dot" />
  </svg>
  <span class="logo__text">
    <span class="logo__name">{business.tradingName}</span>
    <span class="logo__tag">{business.tagline}</span>
  </span>
</a>

<style>
  /* Colours come from --logo-* so a parent (the header over a dark hero) can flip the mark. */
  .logo { display: inline-flex; align-items: center; gap: var(--space-sm); text-decoration: none; color: var(--logo-fg, var(--color-ink)); }
  .logo:hover { color: var(--logo-fg, var(--color-ink)); }
  .logo svg { flex-shrink: 0; }
  .logo__tile { fill: var(--logo-fg, var(--color-ink)); transition: fill 320ms var(--ease-out); }
  .logo__accent { fill: var(--color-accent); }
  .logo__window { fill: var(--logo-bg, var(--color-surface)); transition: fill 320ms var(--ease-out); }
  .logo__dot { fill: var(--logo-fg, var(--color-ink)); transition: fill 320ms var(--ease-out); }
  .logo__text { display: flex; flex-direction: column; line-height: 1.1; }
  .logo__name { font-family: var(--font-body); font-size: 1.0625rem; font-weight: 800; letter-spacing: -0.01em; text-transform: uppercase; }
  .logo__tag { margin-top: 3px; color: var(--logo-sub, var(--color-text-subtle)); font-size: 0.5625rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; }
  @media (max-width: 420px) { .logo__tag { display: none; } }
  .logo--inverse { --logo-fg: var(--color-on-dark); --logo-bg: var(--color-dark); --logo-sub: var(--color-on-dark-muted); }
</style>
