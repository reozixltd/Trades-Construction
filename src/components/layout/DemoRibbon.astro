---
import { business } from '@/config/business';
---

{
  business.demoMode && (
    <div class="ribbon" role="note">
      <strong>Demo site.</strong>{' '}{business.tradingName} is a sample business: licence, ABN, phone numbers, stats and reviews are
      illustrative. Built by <a href="https://reozix.com">Reozix</a>.
    </div>
  )
}

<style>
  .ribbon {
    padding: 0.4rem var(--page-margin);
    background: var(--color-warning-soft);
    border-bottom: 1px solid var(--color-warning-line);
    color: var(--color-warning-ink);
    font-size: var(--text-body-sm);
    line-height: 1.4;
    text-align: center;
  }
  .ribbon a { color: inherit; font-weight: 600; }
</style>
