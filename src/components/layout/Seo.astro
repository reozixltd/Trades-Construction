---
import { jsonLd } from '@/lib/schema';
import { getImage } from 'astro:assets';
import { business } from '@/config/business';
import { getPhoto, photoAlt } from '@/lib/photos';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  schema?: Record<string, unknown>;
}

const { title, description, noindex = false, schema } = Astro.props;
const fullTitle = title.includes(business.tradingName) ? title : `${title} | ${business.tradingName}`;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Share image: the hero frame, cropped to the 1200x630 card that link previews expect.
const shareSlot = getPhoto('hero-poster') ? 'hero-poster' : 'hero';
const sharePhoto = getPhoto(shareSlot);
const share = sharePhoto && (await getImage({ src: sharePhoto, width: 1200, height: 630, format: 'jpg', quality: 78 }));
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<meta property="og:type" content="website" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="en_AU" />
{share && (
  <>
    <meta property="og:image" content={new URL(share.src, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={photoAlt(shareSlot)} />
    <meta name="twitter:card" content="summary_large_image" />
  </>
)}
{schema && <script type="application/ld+json" set:html={jsonLd(schema)} />}
