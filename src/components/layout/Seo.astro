---
import { jsonLd } from '@/lib/schema';
import { getImage } from 'astro:assets';
import { business } from '@/config/business';
import { getPhoto, photoAlt } from '@/lib/photos';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  schema?: Record<string, unknown>;
}

const { title, description, noindex = false, schema } = Astro.props;
const fullTitle = title.includes(business.tradingName) ? title : `${title} | ${business.tradingName}`;
// The 404 page is served at whatever address was asked for, so it has none of its own to declare.
const canonical = Astro.url.pathname.startsWith('/404') ? undefined : new URL(Astro.url.pathname, Astro.site);

// Share image: the hero frame, cropped to the 1.91:1 card that link previews expect (1200x630, or smaller
// when the photo is narrower: the image service does not enlarge).
const shareSlot = getPhoto('hero-poster') ? 'hero-poster' : 'hero';
const sharePhoto = getPhoto(shareSlot);
const shareWidth = Math.min(1200, sharePhoto?.width ?? 1200);
const shareHeight = Math.round(shareWidth * 0.525);
const share = sharePhoto && (await getImage({ src: sharePhoto, width: shareWidth, height: shareHeight, fit: 'cover', format: 'jpg', quality: 78 }));
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{canonical && <link rel="canonical" href={canonical} />}
{noindex && <meta name="robots" content="noindex, nofollow" />}
<meta property="og:type" content="website" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:locale" content="en_AU" />
{share && (
  <>
    <meta property="og:image" content={new URL(share.src, Astro.site)} />
    <meta property="og:image:width" content={String(shareWidth)} />
    <meta property="og:image:height" content={String(shareHeight)} />
    <meta property="og:image:alt" content={photoAlt(shareSlot)} />
    <meta name="twitter:card" content="summary_large_image" />
  </>
)}
{schema && <script type="application/ld+json" set:html={jsonLd(schema)} />}
