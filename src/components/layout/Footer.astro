---
/**
 * Footer with the full licence block on every page (NSW/QLD advertising rules):
 * licensee name with trading name, each licence class + number, issuer, ABN.
 */
import { getCollection } from 'astro:content';
import { business } from '@/config/business';
import { legalNav, primaryNav } from '@/config/navigation';
import { telHref } from '@/lib/format';
import Logo from './Logo.astro';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <Logo inverse />
      <p class="footer__intro">{business.intro}</p>
      <dl class="footer__contact">
        <div><dt>Phone</dt><dd><a href={telHref(business.contact.phone)}>{business.contact.phone}</a></dd></div>
        <div data-live="emergency"><dt>After hours</dt><dd><a href={telHref(business.contact.afterHoursPhone)}>{business.contact.afterHoursPhone}</a></dd></div>
        <div><dt>Email</dt><dd><a href={`mailto:${business.contact.email}`}>{business.contact.email}</a></dd></div>
      </dl>
    </div>

    <nav aria-label="Services">
      <h2 class="footer__heading">Services</h2>
      <ul role="list">{services.map((s) => <li><a href={`/services/${s.id}/`}>{s.data.title}</a></li>)}</ul>
    </nav>

    <nav aria-label="Company">
      <h2 class="footer__heading">Company</h2>
      <ul role="list">
        {primaryNav.filter((l) => l.href !== '/services/').map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        <li><a href="/quote/">Get a quote</a></li>
      </ul>
    </nav>

    <div>
      <h2 class="footer__heading">Hours</h2>
      <ul role="list" class="footer__hours">
        {business.hours.map((h) => <li><span>{h.days}</span><span>{h.hours}</span></li>)}
        <li data-live="emergency"><span>Emergencies</span><span>24/7 line open</span></li>
      </ul>
    </div>
  </div>

  <div class="container">
    <div class="footer__licence" aria-label="Licence details">
      <p>
        <strong>{business.tradingName}</strong> is a trading name of <strong>{business.legalName}</strong> · ABN {business.abn}
      </p>
      <ul role="list">
        {business.licences.map((l) => <li>{l.label}: <strong>Lic. {l.number}</strong> ({l.issuer})</li>)}
      </ul>
    </div>

    <div class="footer__legal">
      <p>© {year} {business.legalName}. Prices shown include GST.</p>
      <ul role="list">{legalNav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </div>
  </div>
</footer>

<style>
  .footer { --focus-ring: var(--focus-ring-dark); padding-top: var(--space-2xl); padding-bottom: calc(var(--space-xl) + 4.5rem); background: var(--color-ink); color: var(--color-on-dark-muted); font-size: var(--text-body-sm); }
  .footer a { color: var(--color-on-dark); text-decoration: none; }
  .footer a:hover { color: var(--color-on-dark); text-decoration: underline; }
  .footer__grid { display: grid; gap: var(--space-xl); grid-template-columns: 1fr 1fr; }
  .footer__brand, .footer__grid > :last-child { grid-column: 1 / -1; }
  .footer__intro { max-width: 30rem; margin-top: var(--space-md); line-height: 1.6; }
  .footer__contact { display: grid; gap: var(--space-xs); margin-top: var(--space-lg); }
  .footer__contact div { display: flex; gap: var(--space-sm); }
  .footer__contact dt { width: 6rem; color: var(--color-on-dark-muted); }
  .footer__contact dd { margin: 0; font-weight: 600; }
  .footer__heading { margin-bottom: var(--space-sm); color: var(--color-on-dark); font-family: var(--font-display); font-size: var(--text-title); font-weight: var(--display-weight); letter-spacing: 0; line-height: 1.3; }
  .footer ul li + li { margin-top: var(--space-xs); }
  .footer__hours li { display: flex; justify-content: space-between; gap: var(--space-md); }
  .footer__hours span:last-child { color: var(--color-on-dark); }

  .footer__licence { margin-top: var(--space-xl); padding-top: var(--space-lg); border-top: 1px solid var(--color-line-dark); line-height: 1.6; }
  .footer__licence strong { color: var(--color-on-dark); }
  .footer__licence ul { margin-top: var(--space-2xs); }
  .footer__licence li + li { margin-top: 0 !important; }

  .footer__legal { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-sm); margin-top: var(--space-lg); padding-top: var(--space-lg); border-top: 1px solid var(--color-line-dark); }
  .footer__legal ul { display: flex; flex-wrap: wrap; gap: var(--space-md); }
  .footer__legal li + li { margin-top: 0 !important; }

  @media (min-width: 1024px) { .footer { padding-bottom: var(--space-xl) !important; } }
  @media (min-width: 900px) {
    .footer { padding-top: var(--space-3xl); }
    .footer__grid { grid-template-columns: 2fr 1fr 1fr 1.3fr; }
    .footer__brand, .footer__grid > :last-child { grid-column: auto; }
  }
</style>
