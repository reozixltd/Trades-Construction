---
/**
 * Section title block, laid out like the title strip of a drawing sheet: a rule across the
 * top, the section's name in the margin, then the heading, lead and an optional aside
 * (e.g. a link). On narrow screens the margin label stacks above the heading.
 */
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  id?: string;
  align?: 'start' | 'center';
  level?: 'h1' | 'h2';
}
const { eyebrow, title, lead, id, align = 'start', level = 'h2' } = Astro.props;
const Heading = level;
---

<header class:list={['heading', `heading--${align}`]}>
  <span class="heading__rule" data-reveal="line" aria-hidden="true"></span>
  {eyebrow && <p class="heading__eyebrow" data-reveal>{eyebrow}</p>}
  <div class="heading__text" data-reveal style="--i: 1">
    <Heading id={id}>{title}</Heading>
    {lead && <p class="heading__lead">{lead}</p>}
  </div>
  {Astro.slots.has('default') && <div class="heading__aside" data-reveal style="--i: 2"><slot /></div>}
</header>

<style>
  .heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-sm) var(--gutter);
    margin-bottom: var(--space-xl);
  }
  .heading__rule { grid-column: 1 / -1; height: 1px; margin-bottom: var(--space-xs); background: var(--color-line-strong); }
  .heading__eyebrow {
    display: flex; align-items: baseline; gap: var(--space-xs);
    color: var(--color-text-muted);
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: var(--label-case);
  }
  /* Survey peg: marks where the section is set out from. */
  .heading__eyebrow::before { content: ''; flex-shrink: 0; width: 7px; height: 7px; background: var(--color-accent); transform: translateY(-1px); }
  .heading__text { max-width: 46rem; }
  .heading__lead { margin-top: var(--space-md); max-width: 36rem; color: var(--color-text-muted); font-size: var(--text-body-lg); line-height: 1.55; }
  .heading__aside { align-self: end; }

  .heading--center { justify-items: center; text-align: center; }
  .heading--center .heading__rule { justify-self: stretch; }
  .heading--center .heading__lead { margin-inline: auto; }

  @media (min-width: 900px) {
    /* The margin column is a fixed share of the row (see .indent), so headings line up whether or not there is an aside. */
    .heading { grid-template-columns: calc((100% - 2 * var(--gutter)) * 2.4 / 9.4) minmax(0, 1fr) auto; margin-bottom: var(--space-2xl); }
    .heading__text { grid-column: 2; }
    .heading:not(:has(.heading__eyebrow)) .heading__text { grid-column: 1 / 3; }
    .heading--center { grid-template-columns: minmax(0, 1fr); }
    .heading--center .heading__text { grid-column: 1; }
  }
</style>
