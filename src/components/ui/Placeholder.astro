---
/**
 * Labelled placeholder for job photos in the demo. A blueprint-style panel
 * rather than stock photos, so nothing can be mistaken for real work (ACL).
 * Replace with <Image> from astro:assets when a client supplies photos.
 */
interface Props {
  label?: string;
  tone?: 'timber' | 'stone' | 'slate' | 'clay';
  ratio?: string;
  caption?: string;
  class?: string;
}
const { label = 'Job photo', tone = 'slate', ratio = '4 / 3', caption, class: className } = Astro.props;
---

<figure class:list={['ph', `ph--${tone}`, className]} style={`aspect-ratio: ${ratio}`}>
  <svg class="ph__grid" aria-hidden="true" preserveAspectRatio="none">
    <defs>
      <pattern id={`g-${tone}`} width="24" height="24" patternUnits="userSpaceOnUse">
        <path d="M24 0H0v24" fill="none" stroke="currentColor" stroke-width="0.5" />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill={`url(#g-${tone})`} />
  </svg>
  <svg class="ph__mark" viewBox="0 0 120 80" aria-hidden="true">
    <path d="M10 70h100M22 70V38l38-24 38 24v32" fill="none" stroke="currentColor" stroke-width="1.5" />
    <path d="M50 70V50h20v20" fill="none" stroke="currentColor" stroke-width="1.5" />
  </svg>
  <span class="ph__label">{label}</span>
  {caption && <figcaption class="visually-hidden">{caption}</figcaption>}
</figure>

<style>
  .ph {
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
    margin: 0;
    border-radius: var(--radius-md);
    color: rgb(255 255 255 / 0.22);
  }
  .ph--slate { background: linear-gradient(135deg, #1e293b, #334155); }
  .ph--timber { background: linear-gradient(135deg, #78350f, #a16207); }
  .ph--stone { background: linear-gradient(135deg, #57534e, #a8a29e); }
  .ph--clay { background: linear-gradient(135deg, #7c2d12, #c2410c); }
  .ph__grid { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ph__mark { position: relative; width: 34%; max-width: 9rem; color: rgb(255 255 255 / 0.55); }
  .ph__label {
    position: absolute;
    left: var(--space-sm);
    bottom: var(--space-sm);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    background: rgb(15 23 42 / 0.7);
    color: #fff;
    font-size: var(--text-label-sm);
    font-weight: 700;
    letter-spacing: var(--tracking-label-sm);
    text-transform: uppercase;
  }
</style>
