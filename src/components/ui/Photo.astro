---
/**
 * Photo for a named slot (src/config/photo-slots.ts).
 * With a file in src/assets/photos/: optimised <Picture> (AVIF + WebP, responsive widths),
 * cropped to `ratio` with space reserved (no layout shift), lazy unless `priority`.
 * Without a file: the labelled blueprint placeholder.
 */
import { Picture } from 'astro:assets';
import { getPhoto, photoAlt } from '@/lib/photos';
import type { PhotoSlotName } from '@/config/photo-slots';
import Placeholder from './Placeholder.astro';

interface Props {
  slot: PhotoSlotName;
  ratio?: string;
  /** `sizes` attribute: how wide the image renders at each breakpoint. */
  sizes?: string;
  /** Above-the-fold hero image: eager + high fetch priority (LCP). */
  priority?: boolean;
  /** Placeholder styling when no file exists. */
  tone?: 'timber' | 'stone' | 'slate' | 'clay';
  label?: string;
  /** Small caption chip over the photo, e.g. "Before". */
  chip?: string;
  class?: string;
}

const { slot, ratio = '4 / 3', sizes = '(min-width: 1024px) 33vw, 100vw', priority = false, tone, label, chip, class: className } = Astro.props;
const image = getPhoto(slot);
const widths = [480, 800, 1200, 1600].filter((w) => !image || w <= image.width);
---

{
  image ? (
    <figure class:list={['photo', className]} style={`aspect-ratio: ${ratio}`}>
      <Picture
        src={image}
        alt={photoAlt(slot)}
        formats={['avif', 'webp']}
        widths={widths.length ? widths : [image.width]}
        sizes={sizes}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
      />
      {chip && <span class="photo__chip">{chip}</span>}
    </figure>
  ) : (
    <Placeholder tone={tone} ratio={ratio} label={chip ?? label ?? 'Job photo'} caption={photoAlt(slot)} class={className} />
  )
}

<style>
  .photo { position: relative; margin: 0; overflow: hidden; border-radius: var(--radius-md); background: var(--color-inset); }
  .photo :global(picture), .photo :global(img) { display: block; width: 100%; height: 100%; }
  .photo :global(img) { object-fit: cover; }
  .photo__chip {
    position: absolute; left: var(--space-sm); bottom: var(--space-sm);
    padding: 0.2rem 0.5rem; border-radius: var(--radius-sm);
    background: var(--color-overlay-chip); color: var(--color-on-dark);
    font-size: var(--text-label-sm); font-weight: 700; letter-spacing: var(--tracking-label-sm); text-transform: uppercase;
  }
</style>
