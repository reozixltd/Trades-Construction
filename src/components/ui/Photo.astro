---
/**
 * Photo for a named slot (src/config/photo-slots.ts).
 * With a file in src/assets/photos/: optimised <Picture> (AVIF + WebP, responsive widths),
 * cropped to `ratio` with space reserved (no layout shift), lazy unless `priority`.
 * Without a file: the labelled blueprint placeholder.
 */
import { Picture } from 'astro:assets';
import { getPhoto, photoAlt } from '@/lib/photos';
import type { PhotoSlotName } from '@/config/photo-slots';
import Placeholder from './Placeholder.astro';

interface Props {
  slot: PhotoSlotName;
  ratio?: string;
  /** `sizes` attribute: how wide the image renders at each breakpoint. */
  sizes?: string;
  /** Above-the-fold hero image: eager + high fetch priority (LCP). */
  priority?: boolean;
  /** Placeholder styling when no file exists. */
  tone?: 'timber' | 'stone' | 'slate' | 'clay';
  label?: string;
  /** Small caption chip over the photo, e.g. "Before". */
  chip?: string;
  /** Overrides the slot's alt text. Pass "" when the photo is a background behind text. */
  alt?: string;
  /** Motion (styles/motion.css): uncover the photo as it scrolls in; drift it inside its frame. */
  reveal?: boolean;
  parallax?: boolean;
  class?: string;
}

const { slot, ratio = '4 / 3', sizes = '(min-width: 1024px) 33vw, 100vw', priority = false, tone, label, chip, alt, reveal = false, parallax = false, class: className } = Astro.props;
const image = getPhoto(slot);
const widths = [480, 800, 1200, 1600, 2000].filter((w) => !image || w <= image.width);
/* Small originals: also offer the full-size file, so wide frames get every pixel there is. */
if (image && image.width < 2000 && !widths.includes(image.width)) widths.push(image.width);
---

{
  image ? (
    <figure class:list={['photo', className]} style={`aspect-ratio: ${ratio}`} data-reveal={reveal ? 'mask' : undefined} data-parallax={parallax ? '' : undefined}>
      <Picture
        src={image}
        alt={alt ?? photoAlt(slot)}
        formats={['avif', 'webp']}
        widths={widths.length ? widths : [image.width]}
        sizes={sizes}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
      />
      {chip && <span class="photo__chip">{chip}</span>}
    </figure>
  ) : (
    <Placeholder tone={tone} ratio={ratio} label={chip ?? label ?? 'Job photo'} caption={photoAlt(slot)} class={className} />
  )
}

<style>
  .photo { position: relative; margin: 0; overflow: hidden; border-radius: var(--radius-md); background: var(--color-inset); }
  .photo :global(picture), .photo :global(img) { display: block; width: 100%; height: 100%; }
  .photo :global(img) { object-fit: cover; }
  .photo__chip {
    position: absolute; left: var(--space-sm); bottom: var(--space-sm);
    padding: 0.25rem 0.6rem; border-radius: var(--radius-sm);
    background: var(--color-overlay-chip); color: var(--color-on-dark);
    font-size: var(--text-label-sm); font-weight: 600; letter-spacing: var(--tracking-label-sm); line-height: 1.4;
  }
</style>
